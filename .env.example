# ---- Server ----
PORT=3000
# Public base URL of this app, used to build the Google OAuth redirect URI.
# Must match exactly what you register in Google Cloud Console.
BASE_URL=http://localhost:3000
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database (Postgres - e.g. a Neon connection string) ----
# Format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Neon (and most managed Postgres) requires SSL. Set to "false" only for a
# local Postgres container that isn't configured for it (see
# docker-compose.yml's local `postgres` service).
DATABASE_SSL=true

# ---- Bootstrap admin (used only the very first time, when the users table is empty) ----
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-please

# ---- Google OAuth 2.0 (Web application client) ----
# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- Poller ----
# Cron expression for how often to poll all connected mailboxes. Only used
# when ENABLE_INTERNAL_POLLER=true (see below) - on Vercel, polling instead
# runs via a Vercel Cron Job hitting /api/cron/poll on this schedule (set
# separately in vercel.json, since Vercel doesn't read this env var).
POLL_CRON=*/3 * * * *

# Set to "true" for always-on deployments (Docker, Render, Railway, plain
# `node src/server.js`) so the in-process scheduler actually runs the
# poller. Leave unset/"false" on Vercel - there's no long-running process
# there for it to run in; POST/GET /api/cron/poll (driven by vercel.json's
# cron schedule) handles polling instead.
ENABLE_INTERNAL_POLLER=true

# Shared secret checked by /api/cron/poll so randoms can't trigger it. Only
# relevant if you're running that endpoint publicly (e.g. on Vercel). Set
# this as a Vercel project env var named exactly CRON_SECRET and Vercel will
# automatically send it as the Authorization header on its Cron Job
# requests. Leave blank for local/Docker testing.
CRON_SECRET=

# Automated-email heuristic score threshold (see src/services/automatedDetection.js)
AUTOMATED_SCORE_THRESHOLD=2
